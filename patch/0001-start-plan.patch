+const START_PLAN_BALANCE_TIMEOUT_MS = 15_000;
+
+/** Start Plan model whitelist from billing/balance, as the desktop host does; undefined if unknown. */
+async function fetchStandaloneStartPlanModelIds(
+  jwt: string,
+  env: Readonly<Record<string, string | undefined>>,
+): Promise<readonly string[] | undefined> {
+  try {
+    const url = new URL(
+      `${resolveRuntimeZCodeEndpointOrigin(env)}/api/v1/zcode-plan/billing/balance`,
+    );
+    // A dev build reports 0.0.0-dev, which billing/balance rejects; allow the installed app version.
+    url.searchParams.set("app_version", env.ZCODE_STANDALONE_APP_VERSION?.trim() || ZCODE_VERSION);
+    const response = await fetch(url, {
+      headers: { Authorization: `Bearer ${jwt}` },
+      signal: AbortSignal.timeout(START_PLAN_BALANCE_TIMEOUT_MS),
+    });
+    const payload = (await response.json().catch(() => ({}))) as {
+      code?: number;
+      msg?: string;
+      data?: { balances?: Array<{ capabilities?: string[]; show_name?: string }> };
+    };
+    if (env.ZCODE_DEBUG_START_PLAN)
+      console.warn("[start-plan-debug] balance", response.status, payload.code, payload.msg,
+        (payload.data?.balances ?? []).map((b) => [b.show_name, b.capabilities]));
+    if (!response.ok) return undefined;
+    const modelIds = new Map<string, string>();
+    for (const balance of payload.data?.balances ?? []) {
+      const fromCapabilities = (balance.capabilities ?? [])
+        .map((capability) => capability.trim())
+        .filter((capability) => capability.toLowerCase().startsWith("model:"))
+        .map((capability) => capability.slice("model:".length).trim());
+      for (const candidate of fromCapabilities.length ? fromCapabilities : [balance.show_name ?? ""]) {
+        const modelId = normalizeOfficialGlmModelId(candidate.trim());
+        if (modelId && !modelIds.has(modelId.toLowerCase())) modelIds.set(modelId.toLowerCase(), modelId);
+      }
+    }
+    return modelIds.size ? [...modelIds.values()] : undefined;
+  } catch (error) {
+    if (env.ZCODE_DEBUG_START_PLAN) console.warn("[start-plan-debug] balance error", String(error));
+    return undefined;
+  }
+}
