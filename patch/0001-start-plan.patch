diff --git a/apps/zcode-cli/packages/bootstrap/tests/standalone-start-plan.test.ts b/apps/zcode-cli/packages/bootstrap/tests/standalone-start-plan.test.ts
new file mode 100644
index 00000000..c2ea5ba5
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/tests/standalone-start-plan.test.ts
@@ -0,0 +1,143 @@
+import { ProviderConfig, ProviderConfigMap, ZhipuAccountAccessConfig } from "@zcode/provider";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createStandaloneProviderRuntimeHeadersPort,
+  readStandaloneAccountProviderConfigSnapshot,
+} from "../src/app/standalone-account-provider-runtime.js";
+
+// Local patch: Start Plan in the standalone CLI.
+const START_PLAN = "account:zai-start-plan";
+const BIGMODEL_START_PLAN = "account:bigmodel-start-plan";
+const JWT_KEY = "zcodejwttoken";
+
+function store(values: Record<string, string>) {
+  return {
+    load: async (key: string) => values[key] ?? null,
+    loadMany: async (keys: readonly string[]) =>
+      Object.fromEntries(keys.map((key) => [key, values[key] ?? null])),
+    save: vi.fn(async () => {}),
+    delete: vi.fn(async () => {}),
+  };
+}
+
+const builtin = {
+  revision: "builtin",
+  providers: new ProviderConfigMap([
+    [
+      START_PLAN,
+      new ProviderConfig({
+        access: new ZhipuAccountAccessConfig({ accountType: "zai", mode: "start-plan" }),
+        builtinModelIds: ["GLM-5.3-Flash", "GLM-5.2"],
+      }),
+    ],
+    [
+      BIGMODEL_START_PLAN,
+      new ProviderConfig({
+        access: new ZhipuAccountAccessConfig({ accountType: "bigmodel", mode: "start-plan" }),
+        builtinModelIds: ["GLM-5.3-Flash"],
+      }),
+    ],
+  ]),
+};
+
+function request(port: ReturnType<typeof createStandaloneProviderRuntimeHeadersPort>) {
+  return port.refreshBeforeModelRequest({
+    providerId: START_PLAN,
+    modelId: "GLM-5.3",
+    accountAccess: { type: "zhipu-account", accountType: "zai", entitled: true, mode: "start-plan" },
+    reason: "model-request",
+    sessionId: "session" as never,
+    traceContext: { traceId: "trace" } as never,
+  });
+}
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe("Standalone Start Plan", () => {
+  it("is entitled with the ZCode JWT and takes its models from the environment, without a balance call", async () => {
+    const fetch = vi.spyOn(globalThis, "fetch");
+    const snapshot = await readStandaloneAccountProviderConfigSnapshot(
+      store({ [JWT_KEY]: "jwt-a" }),
+      { ZCODE_STANDALONE_START_PLAN_MODELS: "glm-5.3, GLM-5.3-Flash" },
+      builtin,
+    );
+    const provider = snapshot.providers.get(START_PLAN);
+    expect(provider?.access).toMatchObject({ entitled: true });
+    expect(provider?.builtinModelIds).toEqual(["GLM-5.3", "GLM-5.3-Flash"]);
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it("takes the model whitelist from billing/balance capabilities", async () => {
+    const fetch = vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(
+        JSON.stringify({
+          code: 200,
+          data: {
+            balances: [
+              { show_name: "GLM-5.3", capabilities: ["model:GLM-5.3"] },
+              { show_name: "GLM-5.3-Flash", capabilities: [] },
+              { show_name: "duplicate", capabilities: ["model:glm-5.3"] },
+            ],
+          },
+        }),
+        { status: 200 },
+      ),
+    );
+    const snapshot = await readStandaloneAccountProviderConfigSnapshot(
+      store({ [JWT_KEY]: "jwt-a" }),
+      {},
+      builtin,
+    );
+    expect(snapshot.providers.get(START_PLAN)?.builtinModelIds).toEqual(["GLM-5.3", "GLM-5.3-Flash"]);
+    const [url, init] = fetch.mock.calls[0]!;
+    expect(String(url)).toContain("/api/v1/zcode-plan/billing/balance");
+    expect((init?.headers as Record<string, string>).Authorization).toBe("Bearer jwt-a");
+  });
+
+  it("keeps the built-in models when billing/balance fails", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ code: 3001, msg: "parameter error" }), { status: 400 }),
+    );
+    const snapshot = await readStandaloneAccountProviderConfigSnapshot(
+      store({ [JWT_KEY]: "jwt-a" }),
+      {},
+      builtin,
+    );
+    const provider = snapshot.providers.get(START_PLAN);
+    expect(provider?.access).toMatchObject({ entitled: true });
+    expect(provider?.builtinModelIds).toBeUndefined();
+  });
+
+  it("is not entitled without the ZCode JWT, and BigModel Start Plan stays out", async () => {
+    const fetch = vi.spyOn(globalThis, "fetch");
+    const snapshot = await readStandaloneAccountProviderConfigSnapshot(store({}), {}, builtin);
+    expect(snapshot.providers.get(START_PLAN)?.access).toMatchObject({ entitled: false });
+    expect(snapshot.providers.get(BIGMODEL_START_PLAN)).toBeUndefined();
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it("authorises a Start Plan request with the ZCode JWT and no project token", async () => {
+    const resolver = { resolve: vi.fn(), resolveMaterial: vi.fn(), clear: vi.fn() };
+    const port = createStandaloneProviderRuntimeHeadersPort(
+      store({ [JWT_KEY]: "jwt-a" }),
+      {},
+      resolver as never,
+    );
+    await expect(request(port)).resolves.toEqual({
+      headersApplied: true,
+      requestAuth: { apiKey: "jwt-a" },
+    });
+    expect(resolver.resolveMaterial).not.toHaveBeenCalled();
+  });
+
+  it("asks for a login when the ZCode JWT is missing", async () => {
+    const port = createStandaloneProviderRuntimeHeadersPort(store({}), {}, {
+      resolve: vi.fn(),
+      resolveMaterial: vi.fn(),
+      clear: vi.fn(),
+    } as never);
+    await expect(request(port)).rejects.toThrow("project_token_login_required");
+  });
+});
